/*Questionnaire*/
%MACRO QLAB(N, VAR1, VAR2, VAR3);
%DO I = 2013 %TO 2017;
PROC SQL; 
CREATE TABLE LAB&N._&I. AS SELECT *
FROM LAB AS A
INNER JOIN (SELECT INDI_DSCM_NO, HME_DT, &VAR1. FROM SOURCE.qtable_&I.) AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, HME_DT;
QUIT;
%END;

PROC SQL; 
CREATE TABLE LAB&N._2018 AS SELECT *
FROM LAB AS A
INNER JOIN (SELECT INDI_DSCM_NO, HME_DT, &VAR2. AS &VAR1. FROM SOURCE.qtable_2018) AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, HME_DT;
QUIT;

%DO I = 2019 %TO 2023;
