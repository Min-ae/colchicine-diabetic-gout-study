/*Data Sources: NHIS claim data 
Enrollment: Patients aged 39 years or older who were prescribed antidiabetic medications and had a diagnosis of diabetes mellitus (ICD-10 codes E11–E14) between 2015 and 2019.

Exclusion: Patients with a history of receiving antidiabetic medications and a diagnosis of diabetes mellitus before 2015.
data period: 2013-2023 Records*/


/* Input dataset */

/*1. Cohort construction*/
PROC SQL;
CREATE TABLE ENROLL AS SELECT A.INDI_DSCM_NO, A.CMN_KEY, A.MDCARE_STRT_DT, A.MCEX_SICK_SYM, B.MCARE_DIV_CD_ADJ, B.GROUP_MAJOR
FROM TOT.DM AS A
INNER JOIN (SELECT * FROM TOT.DRUG WHERE GROUP_MAJOR = "DM") AS B
ON A.CMN_KEY = B.CMN_KEY;
QUIT;

PROC SQL; 
CREATE TABLE ENROLL2 AS SELECT DISTINCT INDI_DSCM_NO, MIN(MDCARE_STRT_DT) AS DM_DT
FROM ENROLL
GROUP BY INDI_DSCM_NO;

CREATE TABLE ENROLL2 AS SELECT A.*, B.STD_YYYY, B.SEX_TYPE, B.BYEAR
FROM ENROLL2 AS A
LEFT JOIN TOT.BFC AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO AND SUBSTR(A.DM_DT,1,4) = B.STD_YYYY;
QUIT;
%INDI(ENROLL2); 

*Exclusion 1: DM before 2015 or under 39;
DATA ENROLL3; SET ENROLL2; 
AGE = STD_YYYY - BYEAR; 
IF AGE LT 39 THEN EXC1 = 1; ELSE EXC1 = 0;
DM_YEAR = SUBSTR(DM_DT,1,4);
IF DM_YEAR LT "2015" THEN EXC1 = 1;
RUN; 

DATA C.ENROLL; SET ENROLL3; 
IF EXC1 NE 1; RUN; 

*Enrollment2; 
PROC SQL; 
CREATE TABLE C.ENROLL AS SELECT DISTINCT *
FROM C.ENROLL AS A
INNER JOIN (SELECT DISTINCT INDI_DSCM_NO, MIN(MDCARE_STRT_DT) AS GOUT_DT 
					FROM TOT.M10 
						WHERE SUBSTR(MDCARE_STRT_DT,1,4) BETWEEN "2015" AND "2019"
					GROUP BY INDI_DSCM_NO)AS B 
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO;
QUIT;
%INDI(C.ENROLL); *230,331;

/*index date at GOUT diagnosis*/ 
DATA C.ENROLL; SET C.ENROLL; 
INDEX_DT = GOUT_DT; 
INDEX_DT1=INPUT(PUT(INDEX_DT,8.),YYMMDD8.); 
INDEX_2YBF = PUT((INDEX_DT1-730.5)+1,YYMMDDN.);
INDEX_1YBF = PUT((INDEX_DT1-365.25)+1,YYMMDDN.);
INDEX_1MAFT = PUT((INDEX_DT1+30)+1,YYMMDDN.); 
RUN;

*Exclusion2) 2013-2023 콜키친 사용가능한 상병 진단;
PROC SQL; 
CREATE TABLE C.EXC2 AS SELECT DISTINCT INDI_DSCM_NO
, MAX(P2_EXC1) AS EXC2
FROM TOT.P2_EXC
GROUP BY INDI_DSCM_NO;
QUIT;

*Exclusion 3)  MI, CAD, angina, Stroke before GOUT ;
PROC SQL;
CREATE TABLE EXC3 AS SELECT A.INDI_DSCM_NO, A.GOUT_DT, B.*
FROM C.ENROLL AS A
INNER JOIN (SELECT DISTINCT INDI_DSCM_NO, P2_EXC2, MDCARE_STRT_DT
				FROM TOT.P2_EXC) AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
WHERE MDCARE_STRT_DT LT GOUT_DT;

CREATE TABLE C.EXC3 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS EXC3 LABEL = "Previous outcome"
FROM EXC3;
QUIT;

*Exclusion 4) 2013-2023 Absolute contraindications;
PROC SQL; 
CREATE TABLE C.EXC4 AS SELECT DISTINCT INDI_DSCM_NO
, MAX(P2_EXC3) AS EXC4
FROM TOT.P2_EXC
GROUP BY INDI_DSCM_NO;
QUIT;

*Exclusion 5): Eligible data;
PROC SQL; 
CREATE TABLE EXC5 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS EXC5
FROM C.ENROLL 
	WHERE AGE = . OR SEX_TYPE = "";
QUIT; *0;

%MACRO AFTDTH; 
%DO I = 2013 %TO 2023; %DO J = 1 %TO 12; %IF &J.<10 %THEN %LET K =0&J.; %ELSE %LET K=&J.;
PROC SQL;
CREATE TABLE AFTDTH_&I.&K. AS 
SELECT A.INDI_DSCM_NO, A.MDCARE_STRT_DT, B.DTH_ASSMD_DT
FROM SOURCE.claimtable_&I.&K. AS A
INNER JOIN SOURCE.death_table AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE A.MDCARE_STRT_DT >  B.DTH_ASSMD_DT;
	QUIT;
%END; %END;
%MEND; 
%AFTDTH;
DATA C.EXC5; SET AFTDTH_:; RUN; 

PROC SQL; 
CREATE TABLE C.EXC5 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS EXC5
FROM C.EXC5; 
QUIT; *364;

*Exclusion 9) Patients without use of other gout medications; 
PROC SQL; 
CREATE TABLE C.EXC9 AS SELECT DISTINCT INDI_DSCM_NO, 0 AS EXC9 LABEL = "Other gout medication", MDCARE_STRT_DT, MCARE_DIV_CD_ADJ, GROUP_MAJOR
FROM (SELECT * FROM TOT.DRUG 
		WHERE GROUP_MAJOR = "GOUT" AND MCARE_DIV_CD_ADJ NE "GOUT");
QUIT;

PROC SQL; 
CREATE TABLE C.EXC9 AS SELECT DISTINCT INDI_DSCM_NO, EXC9
FROM C.EXC9; QUIT;
%indi(exc9); *107,272;

*JOIN; 
%MACRO JOIN;
%DO I = 2 %TO 9;
PROC SQL; 
CREATE TABLE C.ENROLL AS SELECT * FROM C.ENROLL AS A
LEFT JOIN C.EXC&I. AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO;
QUIT;
%END; %MEND;
%JOIN;

PROC STDIZE DATA=C.ENROLL OUT=C.ENROLL
REPONLY MISSING=0; VAR EXC2 EXC3 EXC4 EXC5 EXC6 EXC7 EXC9; RUN;


/*Group non user vs colchicin user:
Patients who received colchicine at least once or for ≥90 days between 2015 and 2023*/
PROC SQL; 
CREATE TABLE C.COL_USER AS SELECT A.INDI_DSCM_NO, A.GOUT_DT, B.MDCARE_STRT_DT, B.TOT_MCNT, B.MCARE_DIV_CD_ADJ
FROM C.ENROLL AS A
INNER JOIN (SELECT * FROM TOT.DRUG 
				WHERE MCARE_DIV_CD_ADJ IN ("GOUT") AND SUBSTR(MDCARE_STRT_DT,1,4) GE "2015")AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT;
QUIT;

*at least once;
PROC SQL; 
CREATE TABLE GROUP AS SELECT DISTINCT INDI_DSCM_NO, GOUT_DT, 1 AS COL_ONCE, MIN(MDCARE_STRT_DT) AS COL_DT
FROM C.COL_USER
GROUP BY INDI_DSCM_NO;
QUIT;
%INDI(C.COL_USER); *58,432: 15-23 at least once;

*≥90 days; 
PROC SQL;
CREATE TABLE COL2 AS SELECT DISTINCT INDI_DSCM_NO, MDCARE_STRT_DT, MAX(TOT_MCNT) AS M_MCNT
FROM C.COL_USER 
GROUP BY INDI_DSCM_NO, MDCARE_STRT_DT;

CREATE TABLE COL3 AS SELECT DISTINCT INDI_DSCM_NO, SUM(M_MCNT) AS COL_MCNT
FROM COL2
GROUP BY INDI_DSCM_NO;

CREATE TABLE COL4 AS SELECT DISTINCT *
,(CASE WHEN COL_MCNT GE 90 THEN 1 ELSE 0 END) AS COL_90
FROM COL3; 
QUIT;

PROC SQL; 
CREATE TABLE C.ENROLL AS SELECT *
FROM C.ENROLL AS A
LEFT JOIN GROUP AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
LEFT JOIN COL4 AS C
ON A.INDI_DSCM_NO = C.INDI_DSCM_NO;
QUIT;

PROC STDIZE DATA=C.ENROLL OUT=C.ENROLL
MISSING=0 REPONLY; VAR COL_90 COL_ONCE; RUN;

DATA C.ENROLL; SET C.ENROLL; 
IF COL_DT NE "" AND COL_DT LT GOUT_DT THEN EXC6 = 1; ELSE EXC6 = 0; RUN;


/*=====================================================
2. Covariate definition
=====================================================*/
 /*CCI: 3 categorical (0, 1, over 2)*/
* Restricted to inpatient records within 1 year before the index date;
* Only the primary diagnosis and first secondary diagnosis were considered;
* Comorbidity scores were assigned using the updated Charlson Comorbidity Index weighting scheme, and the total score was calculated by summing the individual disease weights;

proc sql;
create table cci_tot_index as
select distinct a.*, INPUT(B.INDEX_DT,YYMMDD8.)-input(A.mdcare_strt_dt, yymmdd8.) as dif, b.INDEX_DT
from tot.cci_tot as a inner join C.enroll as b
on a.indi_dscm_no=b.indi_dscm_no
having 0 le dif le 365;
quit;
proc sort data=cci_tot_index; by indi_dscm_no mdcare_strt_dt; run; 

proc sql; 
create table cci_tot_index as select * from cci_tot_index 
	where form_cd in ("02" "07" "09" "10"); 
quit;

proc sql; 
create table cci_tot_index2 as select distinct indi_dscm_no, max(cnt_cci1) as cci1, max(cnt_cci2) as cci2, max(cnt_cci3) as cci3, max(cnt_cci4) as cci4, max(cnt_cci5) as cci5, max(cnt_cci6) as cci6
, max(cnt_cci7) as cci7, max(cnt_cci8) as cci8, max(cnt_cci9) as cci9, max(cnt_cci10) as cci10, max(cnt_cci11) as cci11, max(cnt_cci12) as cci12, max(cnt_cci13) as cci13
, max(cnt_cci14) as cci14, max(cnt_cci15) as cci15, max(cnt_cci16) as cci16, max(cnt_cci17) as cci17
from cci_tot_index
group by indi_dscm_no;
quit;

data cci_tot_index2; set cci_tot_index2; 
if cci11 = 1 then cci10= .; run; 
proc stdize data=cci_tot_index2 out=cci_tot_index2 missing=0 reponly; var cci:; run;

*updated weight;
data C.cci_tot_score; set cci_tot_index2; 
CCI=(cci1*0+cci2*2+cci3*0+cci4*0+cci5*2+cci6+cci7+cci8*0+cci9*2+cci10*0+cci11
+cci12*2+cci13+cci14*2+cci15*6+cci16*4+cci17*4); run;
proc means data=C.cci_tot_score min max mean std; var cci; run; 

*join;
proc sql;
create table C.ENROLL as select A.*, B.CCI from C.ENROLL as a left join 
C.cci_tot_score as b
on a.indi_dscm_no=b.indi_dscm_no;
quit;

proc stdize data=C.ENROLL out=C.ENROLL missing=0 reponly; var cci; run;
DATA C.ENROLL; SET C.ENROLL; 
IF CCI = 0 THEN CCI_GR = 0;
IF CCI = 1 THEN CCI_GR = 1; 
IF CCI GE 2 THEN CCI_GR = 2; 
RUN;

*6-3) CVD history befoer 1 year Index date;
%MACRO CVD(VAR, I);
PROC SQL;
CREATE TABLE CVD&I. AS SELECT *
FROM C.ENROLL AS A
INNER JOIN TOT.&VAR. AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF
	ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT; 

CREATE TABLE C.CVD&I. AS SELECT DISTINCT INDI_DSCM_NO, 1 AS CVD&I.
FROM CVD&I.;
QUIT;
%MEND;
%CVD(MI,1); *CVD 1: Myocardial infarction	I21, I22 with hospitalization AND I25.2;
%CVD(PCI,2); *CVD2: PCI 	M6551, M6552, M6561, M6562, M6563, M6564, M6565, M6566, M6567;
%CVD(HF,3); *CVD3: Heart failure	I43, I50, I099, I110, I130, I132, I255, I420, I425, I426, I427, I428, I429, P290;

*CVD4 Hemorrhagic	I60-I62;
PROC SQL;
CREATE TABLE HEMO_STR AS SELECT * 
FROM TOT.STR
	WHERE HEMORRHAGIC = 1; 


CREATE TABLE C.CVD4 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS CVD4
FROM (SELECT A.*, B.INDI_DSCM_NO, B.INDEX_DT
			FROM HEMO_STR  AS A
			INNER JOIN C.ENROLL AS B
			ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
				WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF);
QUIT;

*CVD5  Ischemic	I63-I64;
PROC SQL;
CREATE TABLE ISCHEMIC_STR AS SELECT * 
FROM TOT.STR
	WHERE ISCHEMIC = 1; 

CREATE TABLE C.CVD5 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS CVD5
FROM (SELECT A.*, B.INDI_DSCM_NO, B.INDEX_DT
			FROM ISCHEMIC_STR  AS A
			INNER JOIN C.ENROLL AS B
			ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
				WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF);
QUIT;

*6-4) Comorbidities	before 1 year index date;
%MACRO COMO(VAR, I);
PROC SQL;
CREATE TABLE COMO&I. AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, A.INDEX_1YBF, B.*
FROM C.ENROLL AS A
INNER JOIN TOT.&VAR. AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF
	ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT; 

CREATE TABLE C.COMO&I. AS SELECT DISTINCT INDI_DSCM_NO, 1 AS COMO&I.
FROM COMO&I.;
QUIT;
%MEND;
%COMO(DM,1); *COMO1: Diabetes	E11-E14 at least once;
%COMO(HTN, 2); *COMO2: 	Hypertension	I10-I13, I15;
%COMO(DYSLIPID,3); *COMO3: 	Dylipidemia	E78 (E786, E788, E789 exclude) AND statin;
PROC SQL;
CREATE TABLE COMO3_1 AS SELECT *
FROM COMO3 AS A
INNER JOIN (SELECT * FROM TOT.DRUG
					WHERE MCARE_DIV_CD_ADJ IN ("Antilipidemic")) AS B
ON A.CMN_KEY =B.CMN_KEY;
QUIT;

PROC SQL;
CREATE TABLE C.COMO3 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS COMO3
FROM COMO3_1;
QUIT;

%COMO(PULMO,4); *COMO4: pulmonary	J40, J41, J42, J43, J44, J45, J46, J47, J60, J61, J62, J63, J64, J65, J66, J67, I278, I279, J684, J701, J703; 
%COMO(LIVER,5); *COMO5: liver	K704, K711, K721, K729, K765, K766, K767, I850, I859, I864, I982;
%COMO(RENAL,6); *COMO6: renal N18, N19, I120, I131, N032, N033, N034, N035, N036, N037, N052, N053, N054, N055, N056, N057, N250, Z490, Z491 Z492, Z940, Z992;

*COMO7: ESRD	O7020, O9991, O7061, O7062, O7071-O7074 산정특례 V001, V003, V005;
PROC SQL;
CREATE TABLE COMO7_V AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, A.INDEX_1YBF, B.*
FROM C.ENROLL AS A
INNER JOIN TOT.ESRD_VCODE AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF
	ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT; 

CREATE TABLE COMO7_PC AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, A.INDEX_1YBF, B.*
FROM C.ENROLL AS A
INNER JOIN TOT.ESRD_PROCEDURE AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF
	ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT; 
QUIT;
DATA COMO7; SET COMO7_V COMO7_PC; RUN; 
PROC SQL;
CREATE TABLE C.COMO7 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS COMO7
FROM COMO7;
QUIT;

%COMO(BRAIN,8); *COMO8:	cerebrovasculart	G45, G46, I60, I61, I62, I63, I64, I65, I66, I67, I68, I69, H340;
%COMO(PAD,9); *COMO9:	pheriperal	I70-I71, I731, I738, I739, I771, I790, I792, K551, K558, K559, Z958, Z959;

*COMO10: cancer	C코드, 산정특례 V027, V193, V194;
PROC SQL;
CREATE TABLE COMO10_CODE AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, A.INDEX_1YBF, B.*
FROM C.ENROLL AS A
INNER JOIN TOT.CANCER AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF
	ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT; 

CREATE TABLE COMO10_V AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, A.INDEX_1YBF, B.*
FROM C.ENROLL AS A
INNER JOIN TOT.CANCER_VCODE AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT LT INDEX_DT AND MDCARE_STRT_DT GE INDEX_1YBF
	ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT; 
QUIT;
DATA COMO10; SET COMO10_CODE COMO10_V; RUN; 
PROC SQL;
CREATE TABLE C.COMO10 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS COMO10
FROM COMO10;
QUIT;

%COMO(VALVE,11); *COMO11:Valve	I05-I09, I34-I39;
%COMO(ARRHYTHM,12) *COMO12: Arrythm	I47-I49;
%COMO(AFIB,13); *COMO13: Atrial fibrillation/flutter	I48.0-48.4, I48.9;


%MACRO JOIN;
%DO I= 1 %TO 5; 
PROC SQL;
CREATE TABLE C.ENROLL AS SELECT * 
FROM C.ENROLL AS A
LEFT JOIN C.CVD&I. AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO;
QUIT;
%END;

%DO I= 1 %TO 13; 
PROC SQL;
CREATE TABLE C.ENROLL AS SELECT * 
FROM C.ENROLL AS A
LEFT JOIN C.COMO&I. AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO;
QUIT;
%END; 
%MEND; 
%JOIN; 

PROC STDIZE DATA=C.ENROLL OUT=C.ENROLL
REPONLY MISSING=0; VAR CVD: COMO:; RUN; 

*6-5) * The laboratory value closest to the index date was selected from all available measurements before the index date
* Evaluated only among patients with available linked health examination data;
DATA LAB; SET C.ENROLL(KEEP=INDI_DSCM_NO INDEX_DT); RUN;

%MACRO LAB(N, VAR1, VAR2, VAR3);
%DO I = 2013 %TO 2017;
PROC SQL; 
CREATE TABLE LAB&N._&I. AS SELECT *
FROM LAB AS A
INNER JOIN (SELECT INDI_DSCM_NO, HME_DT, &VAR1. FROM SOURCE.gumjin_table&I.) AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, HME_DT;
QUIT;
%END;

PROC SQL; 
CREATE TABLE LAB&N._2018 AS SELECT *
FROM LAB AS A
INNER JOIN (SELECT INDI_DSCM_NO, HME_DT, &VAR2. AS &VAR1. FROM SOURCE.gumjin_table_2018) AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, HME_DT;
QUIT;

%DO I = 2019 %TO 2023;
PROC SQL; 
CREATE TABLE LAB&N._&I. AS SELECT *
FROM LAB AS A
INNER JOIN (SELECT INDI_DSCM_NO, HC_DT AS HME_DT, &VAR3. AS &VAR1. FROM SOURCE.gumjin_table_&I.) AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, HME_DT;
QUIT;
%END; 
 %MEND;
 %LAB(1, G1E_FBS, G1E_FBS,G1E_FBS); 
%LAB(2, G1E_TOT_CHOL, G1E_TOT_CHOL,G1E_TOT_CHOL);
%LAB(3, G1E_LDL_CALC, G1E_LDL_CALC,G1E_LDL_CALC);
%LAB(4, G1E_HDL, G1E_HDL,G1E_HDL);
%LAB(5, G1E_TG, G1E_TG, G1E_TG);
%LAB(6, G1E_HGHT,G1E_HGHT,G1E_HGHT );
%LAB(7, G1E_WGHT, G1E_WGHT, G1E_WGHT);
%LAB(8, G1E_WSTC,G1E_WSTC,G1E_WSTC);
%LAB(9, G1E_BP_SYS, G1E_BP_SYS, G1E_BP_SYS); 
%LAB(10, G1E_BP_DIA, G1E_BP_DIA, G1E_BP_DIA);
