CREATE TABLE LAB&N._&I. AS SELECT *
FROM LAB AS A
INNER JOIN (SELECT INDI_DSCM_NO, HC_DT AS HME_DT, &VAR3. AS &VAR1. FROM SOURCE.qtable_&I.) AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, HME_DT;
