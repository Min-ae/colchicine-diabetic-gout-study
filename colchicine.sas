/*Outcome definition*/
*Outcome 1: all cause death; 
PROC SQL; 
CREATE TABLE OUT1 AS SELECT A.INDI_DSCM_NO, A.INDEX_DT,  B.*	
FROM C.ENROLL AS A
INNER JOIN SOURCE.death_table AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE B.DTH_ASSMD_DT GE INDEX_DT AND B.DTH_ASSMD_DT LE "20231231";
	
CREATE TABLE C.OUT1 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS OUT1, DTH_ASSMD_DT AS OUT1_DT
FROM OUT1;
QUIT; *124,538;

*Outcome 2: cv death; 
PROC SQL; 
CREATE TABLE OUT2 AS SELECT *
FROM OUT1  AS A
INNER JOIN (SELECT * FROM SOURCE.FINAL_COD_DB 
				WHERE SUBSTR(DTH_CODE1,1,1) IN ("I"))AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO_M;

CREATE TABLE C.OUT2 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS OUT2, DTH_ASSMD_DT AS OUT2_DT, DTH_CODE1
FROM OUT2;
QUIT; *18110;

*OUT3 * Stroke (hemorrhagic or ischemic): hospitalization for ICD-10 codes I60–I64 with brain CT or MRI;
PROC SQL; 
CREATE TABLE STR AS SELECT DISTINCT A.INDI_DSCM_NO, A.CMN_KEY, A.MDCARE_STRT_DT, A.MCEX_SICK_SYM, B.MCARE_DIV_CD_ADJ, A.FORM_CD
FROM (SELECT * FROM TOT.STR 
				WHERE FORM_CD IN ("02", "07", "09", "10")) AS A
INNER JOIN TOT.BRAIN_PC AS B
ON A.CMN_KEY = B.CMN_KEY;

CREATE TABLE STR AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, B.MDCARE_STRT_DT, B.MCEX_SICK_SYM, B.FORM_CD, B.MCARE_DIV_CD_ADJ
FROM C.ENROLL AS A
INNER JOIN STR AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT GE INDEX_DT; 

CREATE TABLE C.OUT3 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS OUT3, MIN(MDCARE_STRT_DT) AS OUT3_DT
FROM STR
GROUP BY INDI_DSCM_NO; *58,743;
QUIT;

* OUT4: Hospitalization for myocardial infarction (ICD-10 codes I21–I23) based on primary or secondary diagnosis;
DATA MI; SET TOT.OUTCOME_MI;
IF FORM_CD IN ("02", "07", "09", "10");
IF SUBSTR(SICK_SYM1,1,3) IN ("I21", "I22", "I23") OR SUBSTR(SICK_SYM2,1,3) IN ("I21", "I22", "I23");
RUN; 

PROC SQL; 
CREATE TABLE MI AS SELECT A.INDI_DSCM_NO, A.INDEX_DT, B.MDCARE_STRT_DT, B.MCEX_SICK_SYM, B.FORM_CD 
FROM C.ENROLL AS A
INNER JOIN MI AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE MDCARE_STRT_DT GE INDEX_DT; 

CREATE TABLE C.OUT4 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS OUT4, MIN(MDCARE_STRT_DT) AS OUT4_DT
FROM MI
GROUP BY INDI_DSCM_NO; *20539;
QUIT;

/*OUT5	Composite MACE	0: non, 1: yes	CV Death, MI, Stroke */
PROC SQL; 
CREATE TABLE OUT5 AS SELECT * FROM C.OUT2
UNION ALL SELECT  * FROM C.OUT4
UNION ALL SELECT * FROM C.OUT3;
QUIT;

PROC SQL; 
CREATE TABLE C.OUT5 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS OUT5, MIN(OUT2_DT) AS OUT5_DT 
FROM OUT5
GROUP BY INDI_DSCM_NO;
QUIT; *88146;

/*OUT6: Composite MACE All cause death, MI, Stroke*/
PROC SQL; 
CREATE TABLE OUT6 AS SELECT * FROM C.OUT1
UNION ALL SELECT  * FROM C.OUT4
UNION ALL SELECT * FROM C.OUT3;
QUIT;

PROC SQL; 
CREATE TABLE C.OUT6 AS SELECT DISTINCT INDI_DSCM_NO, 1 AS OUT6, MIN(OUT1_DT) AS OUT6_DT 
FROM OUT6
GROUP BY INDI_DSCM_NO;
QUIT; *180,562;


* OUT7: Additional myocardial infarction outcome, defined as hospitalization for ≥3 days with a primary diagnosis of myocardial infarction (ICD-10 codes I21–I22), occurring at least 30 days after the index date;PROC SQL;
CREATE TABLE OUT7 AS SELECT DISTINCT A.INDI_DSCM_NO, A.INDEX_DT, A.INDEX_1MAFT, B.*
FROM C.ENROLL AS A
INNER JOIN C.OUT4 AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE B.OUT4_DT GE INDEX_1MAFT;
QUIT;

PROC SQL; 
CREATE TABLE C.OUT7 AS SELECT DISTINCT INDI_DSCM_NO, OUT4_DT AS OUT7_DT, 1 AS OUT7
FROM OUT7;
QUIT;

*JOIN; 
%MACRO JOIN;
%DO I = 1 %TO 7;
PROC SQL; 
CREATE TABLE C.ENROLL AS SELECT * FROM C.ENROLL AS A
LEFT JOIN C.OUT&I. AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO;
QUIT;
%END; %MEND;
%JOIN;

PROC STDIZE DATA=C.ENROLL OUT=C.ENROLL
MISSING=0 REPONLY; VAR OUT1 OUT2 OUT3 OUT4 OUT5 OUT6;
QUIT;

*DURATION;
%MACRO TDUR;
%DO I = 7 %TO 7;
DATA C.ENROLL; SET C.ENROLL;
IF OUT&I. = 1 THEN TDUR&I. = (INPUT(OUT&I._DT,YYMMDD8.)-INPUT(INDEX_DT,YYMMDD8.))/365.25; 
ELSE IF OUT&I. = 0 AND OUT1 =1 THEN TDUR&I. = (INPUT(OUT1_DT,YYMMDD8.)-INPUT(INDEX_DT,YYMMDD8.))/365.25;
ELSE IF OUT&I. = 0 AND OUT1 =0 THEN TDUR&I. = (INPUT("20231231",YYMMDD8.)-INPUT(INDEX_DT,YYMMDD8.))/365.25;
RUN; 
%END;
%MEND;
%TDUR; 

* Exclusion 6: Patients who experienced an outcome after gout diagnosis but before initiation of colchicine therapy;
PROC SQL; 
CREATE TABLE EXC7 AS SELECT DISTINCT INDI_DSCM_NO, OUT1_DT AS EXC7_DT, OUT1 AS EXC7 FROM C.OUT1
UNION ALL SELECT DISTINCT INDI_DSCM_NO, OUT2_DT AS EXC7_DT, OUT2 AS EXC7 FROM C.OUT2
UNION ALL SELECT DISTINCT INDI_DSCM_NO, OUT3_DT AS EXC7_DT, OUT3 AS EXC7 FROM C.OUT3
UNION ALL SELECT DISTINCT INDI_DSCM_NO, OUT4_DT AS EXC7_DT, OUT4 AS EXC7 FROM C.OUT4
UNION ALL SELECT DISTINCT INDI_DSCM_NO, OUT5_DT AS EXC7_DT, OUT5 AS EXC7 FROM C.OUT5
UNION ALL SELECT DISTINCT INDI_DSCM_NO, OUT6_DT AS EXC7_DT, OUT6 AS EXC7 FROM C.OUT6
ORDER BY INDI_DSCM_NO; QUIT;

PROC SQL; 
CREATE TABLE EXC7 AS SELECT DISTINCT INDI_DSCM_NO, MIN(EXC7_DT) AS EXC7_DT, 1 AS EXC7
FROM EXC7
GROUP BY INDI_DSCM_NO;
QUIT;

PROC SQL; 
CREATE TABLE C.EXC7 AS SELECT DISTINCT A.INDI_DSCM_NO, A.COL_DT, B.*
FROM C.ENROLL AS A
INNER JOIN EXC7 AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
	WHERE EXC7_DT LT COL_DT;
QUIT; *484;

PROC SQL; 
CREATE TABLE C.ENROLL AS SELECT DISTINCT *
FROM C.ENROLL AS A
LEFT JOIN C.EXC7 AS B
ON A.INDI_DSCM_NO= B.INDI_DSCM_NO;
QUIT;


/*Medication*/
PROC SQL; 
CREATE TABLE TOT.DRUG_GRP AS SELECT A.INDI_DSCM_NO, A.MDCARE_STRT_DT, A.MCARE_DIV_CD_ADJ, B.*
FROM TOT.DRUG AS A
INNER JOIN DRUG AS B
ON A.MCARE_DIV_CD_ADJ = B.F1;
QUIT;

PROC SQL; 
CREATE TABLE DRUG2 AS SELECT A.INDI_DSCM_NO, B.*
FROM C.ENROLL AS A
INNER JOIN TOT.DRUG_GRP AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO
ORDER BY INDI_DSCM_NO, MDCARE_STRT_DT;

CREATE TABLE C.MEDI AS SELECT DISTINCT INDI_DSCM_NO
,MAX(NOAC) AS MEDI1
,MAX(Warfarin) AS MEDI2
,MAX(Antilipidemic) AS MEDI3
, MAX(ARB) AS MEDI4
,MAX(Aspirin) AS MEDI5
,MAX(Clopidogrel) AS MEDI6
,MAX(Antiplatelet) AS MEDI7
,MAX(P2Y12) AS MEDI8
,MAX(SGLT2) AS MEDI9
,MAX(ACEI) AS MEDI10
,MAX(Diuretics) AS MEDI11
,MAX(b_blocker) AS MEDI12
FROM DRUG2
GROUP BY INDI_DSCM_NO;
QUIT;

PROC SQL; 
CREATE TABLE C.ENROLL AS SELECT * FROM C.ENROLL AS A
LEFT JOIN C.MEDI AS B
ON A.INDI_DSCM_NO = B.INDI_DSCM_NO;
QUIT;

PROC STDIZE DATA=C.ENROLL OUT=C.ENROLL
MISSING=0 REPONLY; VAR MEDI:;
QUIT;

