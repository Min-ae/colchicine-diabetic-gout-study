%MACRO LABB(N, VAR); *before index (no missing);
DATA LAB&N.; SET LAB&N._:; IF HME_DT LE INDEX_DT AND &VAR. NE .; RUN; 

PROC SORT DATA=LAB&N.; BY INDI_DSCM_NO HME_DT; RUN; 

PROC SQL;
CREATE TABLE LAB&N._2 AS SELECT DISTINCT INDI_DSCM_NO, INDEX_DT, HME_DT, MAX(HME_DT) AS STD_DT, &VAR.
FROM LAB&N.
GROUP BY INDI_DSCM_NO;

CREATE TABLE C.LAB&N. AS SELECT DISTINCT INDI_DSCM_NO, &VAR. AS LAB&N.
FROM LAB&N._2
	WHERE STD_DT = HME_DT; 
QUIT;
%MEND; 
