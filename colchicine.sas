 %MEND;

 *LAB14: Smoking	1. Non-smoker or ex-smoker  2. Current smoker;
%QLAB(14, Q_SMK_YN, Q_SMK_YN, Q_SMK_NOW_YN);

%MACRO SMK_ORG;
%DO I = 2013 %TO 2018;
DATA  LAB14_&I.; SET  LAB14_&I.; 
IF Q_SMK_YN = 1  OR Q_SMK_YN = 2 THEN LAB14 = 0; ELSE LAB14 = 1;
